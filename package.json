{
  "name": "card-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-bundle-budget.mjs",
    "lighthouse": "scripts/lighthouse.sh",
    "e2e:record": "rm -rf .next/cache/fetch-cache && E2E_RECORD=1 playwright test --retries 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@enigmic-co/card-api-contracts": "file:vendor/enigmic-co-card-api-contracts-0.2.0.tgz",
    "@enigmic-co/card-react": "file:vendor/enigmic-co-card-react-0.9.0.tgz",
    "@enigmic-co/card-sdk": "file:vendor/enigmic-co-card-sdk-0.4.0.tgz",
    "@enigmic-co/card-search-core": "file:vendor/enigmic-co-card-search-core-0.4.0.tgz",
    "@enigmic-co/ui": "file:vendor/enigmic-co-ui-0.4.3.tgz",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.4.5",
    "postcss": "^8.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "@enigmic-co/card-api-contracts": "file:vendor/enigmic-co-card-api-contracts-0.2.0.tgz",
      "@enigmic-co/card-react": "file:vendor/enigmic-co-card-react-0.9.0.tgz",
      "@enigmic-co/card-rules-text": "file:vendor/enigmic-co-card-rules-text-0.2.1.tgz",
      "@enigmic-co/card-sdk": "file:vendor/enigmic-co-card-sdk-0.4.0.tgz",
      "@enigmic-co/card-search-core": "file:vendor/enigmic-co-card-search-core-0.4.0.tgz",
      "@enigmic-co/ui": "file:vendor/enigmic-co-ui-0.4.3.tgz",
      "next>postcss": "^8.5.23",
      "next>sharp": "^0.35.5"
    }
  }
}
