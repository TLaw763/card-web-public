# card-api origin the server-side proxy calls (default http://localhost:3001).
PUBLIC_CARD_API_ORIGIN=https://api-dev.enigmic.co.za
# card-api key for that origin; server-only, never NEXT_PUBLIC_.
CARD_API_SERVICE_TOKEN=
# Optional proxy rate limit (defaults: enabled, 120/min per client IP).
# CARD_WEB_BFF_RATE_LIMIT_ENABLED=true
# CARD_WEB_BFF_RATE_LIMIT_PER_MINUTE=120
# Public origin for canonical URLs, the sitemap and link previews (default https://cards.enigmic.co.za).
# CARD_WEB_SITE_URL=http://localhost:3000
# Bearer secret for POST /api/revalidate (drops cached catalog data after a publish). Unset: endpoint off.
# CARD_WEB_REVALIDATE_SECRET=
# Contact address shown in the site footer. Unset: no contact line.
# CARD_WEB_CONTACT_EMAIL=
